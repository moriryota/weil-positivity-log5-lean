RHGammaThm0516.gamma_eq : ∀ (i k : ℕ),
  ∫ (u : ℝ) in -1..1, RHSingDef0516.phi i u * RHSingDef0516.phi k u =
    1 / 4 *
            ((1 + (-1) ^ (i + k)) * RHRec2D0515.Mw (fun x => Real.log (1 + x) ^ 2) i k +
              2 * RHRec2D0515.Mw (fun x => Real.log (1 + x) * Real.log (1 - x)) i k) +
          1 / 2 *
            ∑ a,
              RHGammaExp0516.W a *
                ((1 + (-1) ^ (i + k)) *
                  (RHPairInt0516.F i k (RHGammaExp0516.Sh a) + RHPairInt0516.F k i (RHGammaExp0516.Sh a))) +
        ∑ a,
          ∑ b,
            RHGammaExp0516.W a * RHGammaExp0516.W b *
              ((1 + (-1) ^ (i + k)) * RHPairInt0516.OO i k (RHGammaExp0516.Sh a) (RHGammaExp0516.Sh b)) +
      RHGammaExp0516.W 0 * RHGammaExp0516.W 0 *
        (RHPairInt0516.X i k (RHGammaExp0516.Sh 0) (RHGammaExp0516.Sh 0) +
          RHPairInt0516.X k i (RHGammaExp0516.Sh 0) (RHGammaExp0516.Sh 0))
