        ∑ j ∈ Finset.range (i + 1),
          RHPrAff0511.Af ((1 - t - (s - 1)) / 2) ((s - 1 + (1 - t)) / 2 - s) i j *
              RHPrAff0511.Af ((1 - t - (s - 1)) / 2) ((s - 1 + (1 - t)) / 2 + t) k j *
            (2 / (2 * ↑j + 1))
