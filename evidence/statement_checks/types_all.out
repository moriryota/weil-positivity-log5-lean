=== Zeta23.EF.paperFT_weilTest
@Zeta23.EF.paperFT_weilTest : ∀ {f g : ℝ → ℂ},
  Continuous f →
    Continuous g →
      HasCompactSupport f →
        HasCompactSupport g →
          ∀ (z : ℂ),
            Zeta23.paperFT (Zeta23.EF.weilTest f g) z =
              Zeta23.paperFT f z * (starRingEnd ℂ) (Zeta23.paperFT g ((starRingEnd ℂ) z))
