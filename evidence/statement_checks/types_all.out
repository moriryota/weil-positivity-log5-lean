                  ∑ m ∈ Finset.range 64, W o m j * RHConditionalLog5.basis (RHConditionalLog5.degree o m) x) ^
                2 ≤
        k.tau o) →
    RHCaps0494.G6c RHConcreteParameters.concrete k
