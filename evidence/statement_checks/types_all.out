      (∀ (x : ℝ), h (-x) = h x) →
        (tsupport fun x => ↑(h x)) ⊆ Set.Icc (-b) b →
          (Zeta23.paperFT (fun x => ↑(h x)) (Complex.I / 2) + Zeta23.paperFT (fun x => ↑(h x)) (-Complex.I / 2)).re =
            RH_LiteratureBridge.P_pole b h
=== RH_LiteratureBridge.prime_term_bridge
@RH_LiteratureBridge.prime_term_bridge : ∀ {h : ℝ → ℝ} {b : ℝ},
  0 < b →
    (∀ (x : ℝ), h (-x) = h x) →
      (tsupport fun x => ↑(h x)) ⊆ Set.Icc (-b) b →
        (∑' (n : ℕ), ↑(ArithmeticFunction.vonMangoldt n / √↑n) * (↑(h (Real.log ↑n)) + ↑(h (-Real.log ↑n)))).re =
          2 * ∑' (n : ℕ), ArithmeticFunction.vonMangoldt n / √↑n * h (Real.log ↑n)
=== RH_LiteratureBridge.weilTest_contDiff_of_c1
@RH_LiteratureBridge.weilTest_contDiff_of_c1 : ∀ {f g : ℝ → ℂ},
  ContDiff ℝ 1 f → ContDiff ℝ 1 g → HasCompactSupport f → HasCompactSupport g → ContDiff ℝ 2 (Zeta23.EF.weilTest f g)
=== RH_LiteratureBridge.weil_bridge_of_c1
RH_LiteratureBridge.weil_bridge_of_c1 : ∀ (Z : Zeta23.ZeroConfig),
  Zeta23.EF.EF_lit Z →
    ∀ {f g : ℝ → ℂ},
      ContDiff ℝ 1 f →
        ContDiff ℝ 1 g →
          HasCompactSupport f →
            HasCompactSupport g →
              (Summable fun ρ => Z.Wsummand f g ↑ρ) ∧ Z.W f g = Zeta23.EF.literatureRHS (Zeta23.EF.weilTest f g)
=== RH_Rebaseline.integral_Ioi_K_kernel_eq_T_tail
@RH_Rebaseline.integral_Ioi_K_kernel_eq_T_tail : ∀ {b : ℝ},
  0 < b → ∫ (x : ℝ) in Set.Ioi b, RH_Rebaseline.K_kernel x = RH_Rebaseline.T_tail b
=== Real.exp_bound
@Real.exp_bound : ∀ {x : ℝ},
  |x| ≤ 1 →
    ∀ {n : ℕ},
      0 < n → |Real.exp x - ∑ m ∈ Finset.range n, x ^ m / ↑m.factorial| ≤ |x| ^ n * (↑n.succ / (↑n.factorial * ↑n))
