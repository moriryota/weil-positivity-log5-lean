RHAffRed0516.OO_eq : ∀ (i k : ℕ) {s t : ℝ},
  s < 2 →
    t < 2 →
      RHPairInt0516.OO i k s t =
        (1 - (max s t - 1)) / 2 *
          ∑ j ∈ Finset.range (i + 1),
            RHPrAff0511.Af ((1 - (max s t - 1)) / 2) ((max s t - 1 + 1) / 2 - s) i j *
                RHPrAff0511.Af ((1 - (max s t - 1)) / 2) ((max s t - 1 + 1) / 2 - t) k j *
              (2 / (2 * ↑j + 1))
