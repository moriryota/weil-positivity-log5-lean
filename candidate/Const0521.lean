import LamDef0521
import PrEncl0511
import FRed0516
import Coarse0509
import LeanCert.Core.IntervalRat.Taylor

/-! # 0521: constant balls at scale `2^256` for the G6c pipeline (generated by `gen_const.py`)

For `m = 2, 3, 4` (`σ = σ m = log m / L`): `σ`, `w_m`, `κ = (1−σ/2)/(1+σ/2)`,
`ℓ = log(1−σ/2) + log(1+σ/2)`. LeanCert `logComputable` for the rational log bounds. -/

set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

open LeanCert.Core

namespace RHConst0521
open RHBall0504 RHCoarse0509 RHPrEncl0511 RHBallMisc0512 RHLog5Bridge

lemma hS : 0 < (2:ℕ) ^ 256 := by positivity

lemma mem_bounds {S : ℕ} (hS : 0 < S) {x : ℝ} {b : Ball} (h : mem S x b) :
    ((b.1 : ℝ) - b.2) / S ≤ x ∧ x ≤ ((b.1 : ℝ) + b.2) / S := by
  unfold mem at h
  have hS' : (0:ℝ) < S := by exact_mod_cast hS
  rw [abs_le] at h
  constructor
  · rw [sub_div]; linarith [h.2]
  · rw [add_div]; linarith [h.1]

lemma kappa_bounds {σ lo hi : ℝ} (h1 : lo ≤ σ) (h2 : σ ≤ hi) (h0 : 0 ≤ lo) (h3 : hi < 2) :
    (2 - hi) / (2 + hi) ≤ (1 - σ / 2) / (1 + σ / 2) ∧ (1 - σ / 2) / (1 + σ / 2) ≤ (2 - lo) / (2 + lo) := by
  have e : (1 - σ / 2) / (1 + σ / 2) = (2 - σ) / (2 + σ) := by field_simp
  rw [e]
  constructor
  · rw [div_le_div_iff₀ (by linarith) (by linarith)]; nlinarith
  · rw [div_le_div_iff₀ (by linarith) (by linarith)]; nlinarith

lemma ell_eq {σ : ℝ} (h0 : 0 ≤ σ) (h2 : σ < 2) :
    Real.log (1 - σ / 2) + Real.log (1 + σ / 2) = Real.log (1 - σ ^ 2 / 4) := by
  rw [← Real.log_mul (by linarith) (by linarith)]; congr 1; ring

theorem kap_gen {S : ℕ} (hS : 0 < S) {σ : ℝ} {sB kB : Ball} (hσ : mem S σ sB)
    (c0 : (0 : ℚ) ≤ ((sB.1 : ℚ) - sB.2) / S) (c3 : ((sB.1 : ℚ) + sB.2) / S < 2)
    (c1 : ((kB.1 : ℚ) - kB.2) / S ≤ (2 - ((sB.1 : ℚ) + sB.2) / S) / (2 + ((sB.1 : ℚ) + sB.2) / S))
    (c2 : (2 - ((sB.1 : ℚ) - sB.2) / S) / (2 + ((sB.1 : ℚ) - sB.2) / S) ≤ ((kB.1 : ℚ) + kB.2) / S) :
    mem S ((1 - σ / 2) / (1 + σ / 2)) kB := by
  obtain ⟨h1, h2⟩ := mem_bounds hS hσ
  have r0 : (0:ℝ) ≤ ((sB.1 : ℝ) - sB.2) / S := by exact_mod_cast c0
  have r3 : ((sB.1 : ℝ) + sB.2) / S < 2 := by exact_mod_cast c3
  have d1 : ((kB.1 : ℝ) - kB.2) / S ≤ (2 - ((sB.1 : ℝ) + sB.2) / S) / (2 + ((sB.1 : ℝ) + sB.2) / S) := by
    exact_mod_cast c1
  have d2 : (2 - ((sB.1 : ℝ) - sB.2) / S) / (2 + ((sB.1 : ℝ) - sB.2) / S) ≤ ((kB.1 : ℝ) + kB.2) / S := by
    exact_mod_cast c2
  obtain ⟨k1, k2⟩ := kappa_bounds h1 h2 r0 r3
  exact mem_of_bounds' hS (by linarith) (by linarith)

theorem ell_gen {S : ℕ} (hS : 0 < S) {σ : ℝ} {sB lB : Ball} (hσ : mem S σ sB) {ylo yhi Llo Lhi : ℚ}
    (c0 : (0 : ℚ) ≤ ((sB.1 : ℚ) - sB.2) / S) (c3 : ((sB.1 : ℚ) + sB.2) / S < 2)
    (cy1 : ylo ≤ 1 - (((sB.1 : ℚ) + sB.2) / S) ^ 2 / 4) (cy2 : 1 - (((sB.1 : ℚ) - sB.2) / S) ^ 2 / 4 ≤ yhi)
    (ypos : 0 < ylo) (hlo : (Llo : ℝ) ≤ Real.log ylo) (hhi : Real.log yhi ≤ Lhi)
    (c1 : ((lB.1 : ℚ) - lB.2) / S ≤ Llo) (c2 : Lhi ≤ ((lB.1 : ℚ) + lB.2) / S) :
    mem S (Real.log (1 - σ / 2) + Real.log (1 + σ / 2)) lB := by
  obtain ⟨h1, h2⟩ := mem_bounds hS hσ
  have r0 : (0:ℝ) ≤ ((sB.1 : ℝ) - sB.2) / S := by exact_mod_cast c0
  have r3 : ((sB.1 : ℝ) + sB.2) / S < 2 := by exact_mod_cast c3
  have hσ0 : 0 ≤ σ := le_trans r0 h1
  have hσ2 : σ < 2 := lt_of_le_of_lt h2 r3
  rw [ell_eq hσ0 hσ2]
  have dy1 : (ylo : ℝ) ≤ 1 - (((sB.1 : ℝ) + sB.2) / S) ^ 2 / 4 := by exact_mod_cast cy1
  have dy2 : 1 - (((sB.1 : ℝ) - sB.2) / S) ^ 2 / 4 ≤ (yhi : ℝ) := by exact_mod_cast cy2
  have sq1 : σ ^ 2 ≤ (((sB.1 : ℝ) + sB.2) / S) ^ 2 := pow_le_pow_left₀ hσ0 h2 2
  have sq2 : (((sB.1 : ℝ) - sB.2) / S) ^ 2 ≤ σ ^ 2 := pow_le_pow_left₀ r0 h1 2
  have ypos' : (0:ℝ) < ylo := by exact_mod_cast ypos
  have l1 := Real.log_le_log ypos' (show (ylo : ℝ) ≤ 1 - σ ^ 2 / 4 by linarith)
  have l2 := Real.log_le_log (by nlinarith) (show 1 - σ ^ 2 / 4 ≤ (yhi : ℝ) by linarith)
  have d1 : ((lB.1 : ℝ) - lB.2) / S ≤ Llo := by exact_mod_cast c1
  have d2 : (Lhi : ℝ) ≤ ((lB.1 : ℝ) + lB.2) / S := by exact_mod_cast c2
  exact mem_of_bounds' hS (by linarith) (by linarith)

