theorem sig2_mem : mem (2 ^ 256) (RHSingDef0516.σ 2) sig2 := by
  have h := RHPrEncl0511.sig2_mem
  have hw : within sB2 sig2.1 sig2.2 256 = true := by decide +kernel
  have h' : mem (2 ^ (256 + 256)) (Real.log 2 / halfWidth) sB2 := by simpa [S512] using h
  have := mem_coarse h' hw
  simpa [RHSingDef0516.σ] using this

theorem w2_mem : mem (2 ^ 256) RHPrSum0511.w2 w2B := by
  have h := RHPrEncl0511.w2_mem
  have hw : within wB2 w2B.1 w2B.2 256 = true := by decide +kernel
  have h' : mem (2 ^ (256 + 256)) RHPrSum0511.w2 wB2 := by simpa [S512] using h
  exact mem_coarse h' hw

theorem kap2_mem : mem (2 ^ 256) ((1 - RHSingDef0516.σ 2 / 2) / (1 + RHSingDef0516.σ 2 / 2)) kap2 :=
  kap_gen hS sig2_mem (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)

lemma logLo2 : ((Llo2 : ℚ) : ℝ) ≤ Real.log ylo2 := by
  have ypos : (0:ℚ) < ylo2 := by decide +kernel
  have e := IntervalRat.mem_logComputable (IntervalRat.mem_singleton ylo2) (by simpa [IntervalRat.singleton] using ypos) 400
  change ((encLo2.lo : ℚ) : ℝ) ≤ Real.log ylo2 ∧ Real.log ylo2 ≤ (encLo2.hi : ℝ) at e
  have f : Llo2 ≤ encLo2.lo := by decide +kernel
  exact le_trans (by exact_mod_cast f) e.1

lemma logHi2 : Real.log yhi2 ≤ ((Lhi2 : ℚ) : ℝ) := by
  have ypos : (0:ℚ) < yhi2 := by decide +kernel
  have e := IntervalRat.mem_logComputable (IntervalRat.mem_singleton yhi2) (by simpa [IntervalRat.singleton] using ypos) 400
  change ((encHi2.lo : ℚ) : ℝ) ≤ Real.log yhi2 ∧ Real.log yhi2 ≤ (encHi2.hi : ℝ) at e
  have f : encHi2.hi ≤ Lhi2 := by decide +kernel
  exact le_trans e.2 (by exact_mod_cast f)

theorem ell2_mem : mem (2 ^ 256) (Real.log (1 - RHSingDef0516.σ 2 / 2) + Real.log (1 + RHSingDef0516.σ 2 / 2)) ell2 :=
  ell_gen hS sig2_mem (ylo := ylo2) (yhi := yhi2) (Llo := Llo2) (Lhi := Lhi2)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    logLo2 logHi2 (by decide +kernel) (by decide +kernel)

