def Qn (o : Bool) (i j : ℕ) : ℚ := ((if o then RHBQ0512.oddTab else RHBQ0512.evenTab).getD i []).getD j 0
def Bp (o : Bool) (i j : ℕ) : Ball := mulB (2 ^ 256) (qBall (2 ^ 256) (Qn o i j)) (gz sqL (degree o i))
def colB (o : Bool) (j : ℕ) : List Ball := (List.range 32).map (fun i => Bp o i j)
def Tj (o : Bool) (R : List (List Ball)) (j : ℕ) : Ball :=
  dotB (2 ^ 256) (colB o j) (R.map (fun row => dotB (2 ^ 256) row (colB o j)))
def tot (o : Bool) (R : List (List Ball)) : ℤ := ((List.range 32).map (fun j => (Tj o R j).1 + (Tj o R j).2)).sum
def csum (o : Bool) (j : ℕ) : ℕ := ((List.range 32).map (fun i => (qBall (2 ^ 256) (Qn o i j)).1.natAbs + 1)).sum
def Esum (o : Bool) : ℕ := ((List.range 32).map (fun j => csum o j ^ 2)).sum
def dMq (o : Bool) : ℚ := if o then 1230379 / 1000000 else 1409795 / 1000000

def check (o : Bool) (R : List (List Ball)) : Bool :=
  decide ((1 + 1 / 10 ^ 4 : ℚ) * ((tot o R : ℚ) / 2 ^ 256) +
    (1 + 10 ^ 4 : ℚ) * 2 * (81 / 100) * (1 / 10 ^ 28) * ((Esum o : ℚ) / (2 ^ 256) ^ 2) ≤ 99 / 100 * dMq o)

