  | _, _ => 0
noncomputable def oddB : Matrix (Fin 32) (Fin 32) ℝ :=
  fun i j => if i = j then oddDiag i else if i < j then oddUpper i j else 0
theorem odd_diag_ne_zero (i : Fin 32) : oddDiag i ≠ 0 := by
  fin_cases i <;> norm_num [oddDiag]
noncomputable def B (o : Bool) : Matrix (Fin 32) (Fin 32) ℝ :=
  if o then oddB else evenB
theorem B_upper (o : Bool) : (B o).IsUpperTriangular := by
  intro i j h
  have hij : i ≠ j := ne_of_gt h
  have hn : ¬ i < j := not_lt_of_ge h.le
  cases o <;> simp [B, evenB, oddB, hij, hn]
theorem B_diag_ne_zero (o : Bool) (i : Fin 32) : B o i i ≠ 0 := by
  cases o
  · simpa [B, evenB] using even_diag_ne_zero i
  · simpa [B, oddB] using odd_diag_ne_zero i
theorem B_det_ne_zero (o : Bool) : (B o).det ≠ 0 := by
  rw [Matrix.det_of_isUpperTriangular (B_upper o)]
  exact Finset.prod_ne_zero_iff.mpr (fun i _ => B_diag_ne_zero o i)
noncomputable def coordinates (o : Bool) (a : Fin 32 → ℝ) : Fin 32 → ℝ :=
  (B o)⁻¹ *ᵥ a
theorem coordinates_identity (o : Bool) (a : Fin 32 → ℝ) :
    B o *ᵥ coordinates o a = a := by
  unfold coordinates
  rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr (B_det_ne_zero o)), Matrix.one_mulVec]
end RHFixedCoordinates
