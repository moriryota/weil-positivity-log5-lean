lemma V0_eq (n k : ℕ) : V n k 0 = (1/2) * ∫ u in (-1:ℝ)..1, p n u * p k u := by
  have e : (fun u => p n u * p k u) = fun u => ∑ l ∈ range (n + k + 1), V n k l * (p l u * p 0 u) := by
    funext u; rw [RHProd0508.prod_eq, evV]; exact sum_congr rfl (fun l _ => by rw [p_zero]; ring)
  rw [e, intervalIntegral.integral_finsetSum (f := fun l u => V n k l * (p l u * p 0 u))
    (fun l _ => (continuous_const.mul ((continuous_p l).mul (continuous_p 0))).intervalIntegrable _ _)]
  simp_rw [intervalIntegral.integral_const_mul, RHLink0505.orth]
  rw [sum_eq_single 0 (fun l _ hl => by rw [if_neg hl, mul_zero]) (fun h => by simp at h)]
  simp; ring

lemma Lcc (n k : ℕ) : halfWidth * cc n * cc k * (∫ u in (-1:ℝ)..1, p n u * p k u) = if n = k then 1 else 0 := by
  rw [RHLink0505.orth]
  split_ifs with h
  · subst h
    have hL := halfWidth_pos
    have hs : cc n * cc n = (2 * n + 1) / (2 * halfWidth) := Real.mul_self_sqrt (by positivity)
    have h2 : (2 * (n : ℝ) + 1) ≠ 0 := by positivity
    calc halfWidth * cc n * cc n * (2 / (2 * n + 1)) = halfWidth * (cc n * cc n) * (2 / (2 * n + 1)) := by ring
      _ = 1 := by rw [hs]; field_simp
  · ring

/-! coefficient error for `gq` -/
def aI (i : ℕ) : ℚ := (RHGApprox0501.integL RHRkApprox0500.ql).getD i 0
def gqq (i : ℕ) : ℚ := ((gq.getD i (0, 1)).1 : ℚ) / ((gq.getD i (0, 1)).2 : ℚ)
def Dg (i : ℕ) : ℚ := max |2 * aI i * RHRpCoef0506.lo ^ i - gqq i| |2 * aI i * RHRpCoef0506.hi ^ i - gqq i|
def Dgsum : ℚ := ∑ i ∈ range 82, Dg i * 2 ^ i
lemma Dgsum_le : Dgsum ≤ 1 / 10 ^ 32 := by decide +kernel
lemma Mg_eq : Mg = 82 := by decide +kernel
lemma gq_den (i : ℕ) : 0 < (gq.getD i (0, 1)).2 := by
  by_cases h : i < 82
  · interval_cases i <;> decide +kernel
  · rw [List.getD_eq_default _ _ (by simp [gq]; omega)]; decide

lemma gm_close (i : ℕ) : |gm i - gqv gq i| ≤ (Dg i : ℝ) := by
  have h5 := RHEntry00Bounds0495.b_l5
  have hx : (halfWidth / 2) = Real.log 5 / 4 := by unfold RHLog5Bridge.halfWidth; ring
  have hlo0 : (0:ℝ) ≤ ((RHRpCoef0506.lo : ℚ) : ℝ) := by
    have : (0:ℚ) ≤ RHRpCoef0506.lo := by unfold RHRpCoef0506.lo; decide +kernel
    exact_mod_cast this
  have ha : ((RHRpCoef0506.lo : ℚ) : ℝ) ^ i ≤ (halfWidth / 2) ^ i := by
    apply pow_le_pow_left₀ hlo0; rw [hx]; unfold RHRpCoef0506.lo; push_cast; linarith [h5.1]
  have hb : (halfWidth / 2) ^ i ≤ ((RHRpCoef0506.hi : ℚ) : ℝ) ^ i := by
    apply pow_le_pow_left₀ (by rw [hx]; have := Real.log_pos (by norm_num : (1:ℝ) < 5); positivity)
    rw [hx]; unfold RHRpCoef0506.hi; push_cast; linarith [h5.2]
  have h := RHRpCoef0506.between (c := ((2 * aI i : ℚ) : ℝ)) (r := ((gqq i : ℚ) : ℝ)) ha hb
  have e1 : gm i = ((2 * aI i : ℚ) : ℝ) * (halfWidth / 2) ^ i := by unfold gm aI; push_cast; ring
  have e2 : gqv gq i = ((gqq i : ℚ) : ℝ) := by unfold gqv gqq; push_cast; rfl
  rw [e1, e2]
  refine h.trans (le_of_eq ?_)
  unfold Dg; push_cast; rfl

lemma X_bound (n k i : ℕ) :
    |∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * β 0 i l)| ≤ 2 ^ i * 2 := by
  rw [← powint]
  have hc : Continuous fun u => (2:ℝ) ^ i * (|p n u| * |p k u|) := by fun_prop
  have h := intervalIntegral.norm_integral_le_of_norm_le (μ := volume) (a := -1) (b := 1)
    (f := fun u => (1 + u) ^ i * evV (n + k + 1) (V n k) u)
    (g := fun u => (2:ℝ) ^ i * (|p n u| * |p k u|)) (by norm_num)
    (Filter.Eventually.of_forall (fun u hu => by
      rw [Real.norm_eq_abs, ← RHProd0508.prod_eq, abs_mul, abs_mul, abs_pow]
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      apply pow_le_pow_left₀ (abs_nonneg _)
      rw [abs_le]; constructor <;> linarith [hu.1, hu.2]))
    (hc.intervalIntegrable _ _)
  rw [Real.norm_eq_abs, intervalIntegral.integral_const_mul] at h
  have := RHRpCoef0506.absprod1 n k
  calc _ ≤ _ := h
    _ ≤ 2 ^ i * 2 := mul_le_mul_of_nonneg_left this (by positivity)

lemma S_split (n k : ℕ) :
    S n k = V n k 0 * muR 0 + TS n 82 gq k (n + k + 1) +
      ∑ i ∈ range 82, (gm i - gqv gq i) * ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * β 0 i l) := by
  unfold S TS WqR
  rw [Mg_eq]
  have h1 : ∑ l ∈ range (n + k + 1), V n k l * muR l =
      V n k 0 * muR 0 + ∑ l ∈ range (n + k + 1), V n k l * muR' l := by
    rw [sum_range_succ', sum_range_succ' (fun l => V n k l * muR' l)]
    simp [muR']; ring
  have h2 : ∑ i ∈ range 82, gm i * ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * β 0 i l) =
      ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * ∑ i ∈ range 82, gqv gq i * β 0 i l) +
      ∑ i ∈ range 82, (gm i - gqv gq i) * ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * β 0 i l) := by
    have : ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * ∑ i ∈ range 82, gqv gq i * β 0 i l) =
        ∑ i ∈ range 82, gqv gq i * ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * β 0 i l) := by
      simp_rw [mul_sum]; rw [sum_comm]; exact sum_congr rfl (fun i _ => sum_congr rfl (fun l _ => by ring))
    rw [this, ← sum_add_distrib]
    exact sum_congr rfl (fun i _ => by ring)
  rw [h1, h2]; ring

theorem Tp_encl (n k : ℕ) {c : ℤ} {r : ℕ} (hball : mem (2 ^ 128) (TS n 82 gq k (n + k + 1)) (c, r)) :
    |RHColDecomp0499.Tp n k - ((if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) -
      halfWidth * cc n * cc k * ((1 + (-1) ^ (n + k)) / 2) * ((c : ℝ) / 2 ^ 128))| ≤
      halfWidth * cc n * cc k * ((1 + (-1) ^ (n + k)) / 2) * ((r : ℝ) / 2 ^ 128 + 2 / 10 ^ 32) +
        2 / 10 ^ 24 * halfWidth := by
  have hL := halfWidth_pos
  have he := Tp_err n k
  have hX := TpX_eq n k
  rw [S_split] at hX
  set σ : ℝ := (1 + (-1) ^ (n + k)) / 2 with hσ
  have hσ0 : 0 ≤ σ := by
    rw [hσ]; rcases neg_one_pow_eq_or ℝ (n + k) with h | h <;> rw [h] <;> norm_num
  set F := halfWidth * cc n * cc k with hF
  have hF0 : 0 ≤ F := by
    rw [hF]; exact mul_nonneg (mul_nonneg hL.le (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)
  set I := ∫ u in (-1:ℝ)..1, p n u * p k u
  have hLI : F * I = if n = k then 1 else 0 := Lcc n k
  set dG := ∑ i ∈ range 82, (gm i - gqv gq i) * ∑ l ∈ range (n + k + 1), V n k l * (2 / (2 * l + 1) * β 0 i l)
  have hdG : |dG| ≤ 2 / 10 ^ 32 := by
    have h1 : |dG| ≤ ∑ i ∈ range 82, (Dg i : ℝ) * (2 ^ i * 2) := by
      refine (abs_sum_le_sum_abs _ _).trans (sum_le_sum (fun i _ => ?_))
      rw [abs_mul]; exact mul_le_mul (gm_close i) (X_bound n k i) (abs_nonneg _)
        (le_trans (abs_nonneg _) (gm_close i))
    have h2 : ∑ i ∈ range 82, (Dg i : ℝ) * (2 ^ i * 2) = 2 * ((Dgsum : ℚ) : ℝ) := by
      unfold Dgsum; push_cast; rw [mul_sum]; exact sum_congr rfl (fun i _ => by ring)
    have h3 : ((Dgsum : ℚ) : ℝ) ≤ 1 / 10 ^ 32 := by
      have := (Rat.cast_le (K := ℝ)).mpr Dgsum_le; push_cast at this; exact this
    linarith
  have hV0 : V n k 0 * muR 0 = I * (Real.log 2 - 1) := by
    rw [V0_eq]; simp only [muR]; ring
  unfold mem at hball
  push_cast at hball
  -- TpX in final form
  have hX2 : TpX n k = (if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) -
      F * σ * (TS n 82 gq k (n + k + 1) + dG) := by
    rw [hX, hV0]
    have hI : F * I * (g0 - Real.log halfWidth) - F * I * σ * 2 * (Real.log 2 - 1) / 2 =
        (if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) := by
      rw [hLI]; split_ifs with h
      · subst h; rw [hσ]; rw [show n + n = 2 * n by ring, pow_mul]; norm_num
      · ring
    rw [← hI, hσ]; ring
  rw [hX2] at he
  have key : |F * σ * (TS n 82 gq k (n + k + 1) + dG) - F * σ * ((c : ℝ) / 2 ^ 128)| ≤
      F * σ * ((r : ℝ) / 2 ^ 128 + 2 / 10 ^ 32) := by
    rw [← mul_sub, abs_mul, abs_of_nonneg (mul_nonneg hF0 hσ0)]
    apply mul_le_mul_of_nonneg_left _ (mul_nonneg hF0 hσ0)
    have := abs_add_le (TS n 82 gq k (n + k + 1) - (c : ℝ) / 2 ^ 128) dG
    have e : TS n 82 gq k (n + k + 1) + dG - (c : ℝ) / 2 ^ 128 = (TS n 82 gq k (n + k + 1) - (c : ℝ) / 2 ^ 128) + dG := by ring
    rw [e]; linarith
  have := abs_sub_le (RHColDecomp0499.Tp n k)
    ((if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) - F * σ * (TS n 82 gq k (n + k + 1) + dG))
    ((if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) - F * σ * ((c : ℝ) / 2 ^ 128))
  have e2 : |((if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) - F * σ * (TS n 82 gq k (n + k + 1) + dG)) -
      ((if n = k then g0 - Real.log halfWidth - (Real.log 2 - 1) else 0) - F * σ * ((c : ℝ) / 2 ^ 128))| =
      |F * σ * (TS n 82 gq k (n + k + 1) + dG) - F * σ * ((c : ℝ) / 2 ^ 128)| := by
    rw [abs_sub_comm]; congr 1; ring
  linarith

