theorem sqrt2_bounds : (sqrt2Lo : ℝ) ≤ Real.sqrt 2 ∧ Real.sqrt 2 ≤ (sqrt2Hi : ℝ) := by
  constructor
  · apply Real.le_sqrt_of_sq_le
    norm_num [sqrt2Lo]
  · apply (Real.sqrt_le_left (by norm_num [sqrt2Hi])).2
