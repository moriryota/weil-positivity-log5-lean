def tl : List ℚ := [0, 1]
def twoT : List ℚ := [0, 2]
def Pl : List ℚ := subL (subL (mulL tl (addL Cl Sl)) (mulL Sl Cl)) (mulL twoT (mulL (mulL Sl Cl) ql))
def A1 : List ℚ := subL (subL tl Cl) (mulL twoT (mulL Cl ql))
def B1 : List ℚ := subL (subL tl Sl) (mulL twoT (mulL Sl ql))
def C1 : List ℚ := addL [1] (mulL twoT ql)
def aQ : ℚ := 4024 / 5000
/-- `31/(30!·30)`, the `Real.exp_bound` constant for `n = 30`. -/
def cE : ℚ := 31 / (265252859812191058636308480000000 * 30)
def EP : ℚ := evQ (absL (Pl.drop 2)) aQ
def EA : ℚ := evQ (absL A1) aQ
def EB : ℚ := evQ (absL B1) aQ
def EC : ℚ := evQ (absL C1) aQ
def bnd : ℚ := (EP + aQ ^ 28 * cE * (EA + EB) + aQ ^ 58 * cE ^ 2 * EC) / 2

lemma Pl_head : Pl.take 2 = [0, 0] := by decide +kernel
lemma bnd_le : bnd ≤ 2 / 10 ^ 24 := by decide +kernel

lemma ev_Sl (t : ℝ) : ev Sl t =
    ((∑ m ∈ range 30, t ^ m / m.factorial) - ∑ m ∈ range 30, (-t) ^ m / m.factorial) / 2 := by
  rw [Sl, ev_range, ← sum_sub_distrib, sum_div]
  refine sum_congr rfl (fun i _ => ?_)
  rcases Nat.even_or_odd i with he | ho
  · have h : i % 2 = 0 := Nat.even_iff.mp he
    simp [h, he.neg_pow]
  · have h : i % 2 = 1 := Nat.odd_iff.mp ho
    simp [h, ho.neg_pow]; ring

lemma ev_Cl (t : ℝ) : ev Cl t =
    ((∑ m ∈ range 30, t ^ m / m.factorial) + ∑ m ∈ range 30, (-t) ^ m / m.factorial) / 2 := by
  rw [Cl, ev_range, ← sum_add_distrib, sum_div]
  refine sum_congr rfl (fun i _ => ?_)
  rcases Nat.even_or_odd i with he | ho
  · have h : i % 2 = 0 := Nat.even_iff.mp he
    simp [h, he.neg_pow]; ring
  · have h : i % 2 = 1 := Nat.odd_iff.mp ho
    simp [h, ho.neg_pow]; ring

lemma exp_pair {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    |Real.exp t - ∑ m ∈ range 30, t ^ m / m.factorial| ≤ t ^ 30 * cE ∧
    |Real.exp (-t) - ∑ m ∈ range 30, (-t) ^ m / m.factorial| ≤ t ^ 30 * cE := by
  have h1 := Real.exp_bound (x := t) (by rw [abs_of_nonneg ht0]; exact ht1) (n := 30) (by norm_num)
  have h2 := Real.exp_bound (x := -t) (by rw [abs_neg, abs_of_nonneg ht0]; exact ht1) (n := 30)
    (by norm_num)
  rw [abs_of_nonneg ht0] at h1
  rw [abs_neg, abs_of_nonneg ht0] at h2
  have hc : ((Nat.succ 30 : ℕ) : ℝ) / ((Nat.factorial 30 : ℕ) * (30 : ℕ)) = (cE : ℝ) := by
    rw [cE, Nat.factorial]; norm_num [Nat.factorial]
  rw [hc] at h1 h2
  exact ⟨h1, h2⟩

lemma sinh_near {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) : |Real.sinh t - ev Sl t| ≤ t ^ 30 * cE := by
  obtain ⟨h1, h2⟩ := exp_pair ht0 ht1
  rw [ev_Sl, Real.sinh_eq]
  have : Real.exp t - Real.exp (-t) - ((∑ m ∈ range 30, t ^ m / m.factorial) -
      ∑ m ∈ range 30, (-t) ^ m / m.factorial) =
      (Real.exp t - ∑ m ∈ range 30, t ^ m / m.factorial) -
      (Real.exp (-t) - ∑ m ∈ range 30, (-t) ^ m / m.factorial) := by ring
  rw [← sub_div, this, abs_div, abs_two]
  have := abs_sub (Real.exp t - ∑ m ∈ range 30, t ^ m / m.factorial)
    (Real.exp (-t) - ∑ m ∈ range 30, (-t) ^ m / m.factorial)
  rw [div_le_iff₀ (by norm_num)]; linarith

lemma cosh_near {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) : |Real.cosh t - ev Cl t| ≤ t ^ 30 * cE := by
  obtain ⟨h1, h2⟩ := exp_pair ht0 ht1
  rw [ev_Cl, Real.cosh_eq]
  have : Real.exp t + Real.exp (-t) - ((∑ m ∈ range 30, t ^ m / m.factorial) +
      ∑ m ∈ range 30, (-t) ^ m / m.factorial) =
      (Real.exp t - ∑ m ∈ range 30, t ^ m / m.factorial) +
      (Real.exp (-t) - ∑ m ∈ range 30, (-t) ^ m / m.factorial) := by ring
  rw [← sub_div, this, abs_div, abs_two]
  have := abs_add_le (Real.exp t - ∑ m ∈ range 30, t ^ m / m.factorial)
    (Real.exp (-t) - ∑ m ∈ range 30, (-t) ^ m / m.factorial)
  rw [div_le_iff₀ (by norm_num)]; linarith

lemma Rk_two_mul {t : ℝ} (ht : 0 < t) :
    RHColDecomp0499.Rk (2 * t) =
      (t * Real.cosh t + t * Real.sinh t - Real.sinh t * Real.cosh t) /
        (2 * t * Real.sinh t * Real.cosh t) := by
  have hsh : 0 < Real.sinh t := Real.sinh_pos_iff.mpr ht
  have hch : 0 < Real.cosh t := Real.cosh_pos t
  unfold RHColDecomp0499.Rk RH_GammaFinalFormula.K_kernel RH_GammaSqrtBound.K_kernel
  rw [show 2 * t / 2 = t by ring, Real.sinh_two_mul, ← Real.cosh_add_sinh]
  field_simp

theorem Rk_two_mul_approx {t : ℝ} (ht : 0 < t) (hta : t ≤ aQ) :
    |RHColDecomp0499.Rk (2 * t) - ev ql t| ≤ (bnd : ℝ) := by
  have ha1 : ((aQ : ℚ) : ℝ) ≤ 1 := by unfold aQ; norm_num
  have ht1 : t ≤ 1 := hta.trans ha1
  have hsh : t ≤ Real.sinh t := Real.self_le_sinh_iff.mpr ht.le
  have hch : 1 ≤ Real.cosh t := Real.one_le_cosh t
  have hshp : 0 < Real.sinh t := ht.trans_le hsh
  have hD : 0 < 2 * t * Real.sinh t * Real.cosh t := by positivity
  set sh := Real.sinh t with hsh_def
  set ch := Real.cosh t with hch_def
  set S := ev Sl t
  set C := ev Cl t
  set Q := ev ql t
  have hP : ev Pl t = t * (C + S) - S * C - 2 * t * (S * C * Q) := by
    simp only [Pl, ev_subL, ev_mulL, ev_addL, tl, twoT, ev]; push_cast; ring
  have hA : ev A1 t = t - C - 2 * t * (C * Q) := by
    simp only [A1, ev_subL, ev_mulL, tl, twoT, ev]; push_cast; ring
  have hB : ev B1 t = t - S - 2 * t * (S * Q) := by
    simp only [B1, ev_subL, ev_mulL, tl, twoT, ev]; push_cast; ring
  have hC : ev C1 t = 1 + 2 * t * Q := by
    simp only [C1, ev_addL, ev_mulL, twoT, ev]; push_cast; ring
  set a := sh - S with ha_def
  set b := ch - C with hb_def
  have hdiff : RHColDecomp0499.Rk (2 * t) - Q =
      (ev Pl t + a * ev A1 t + b * ev B1 t + -(a * b * ev C1 t)) / (2 * t * sh * ch) := by
    rw [Rk_two_mul ht, hP, hA, hB, hC, ha_def, hb_def]
    field_simp
    ring
  have hta' : t ≤ ((aQ : ℚ) : ℝ) := hta
  have hEPn : 0 ≤ ((EP : ℚ) : ℝ) := by rw [EP, ← ev_cast]; exact ev_absL_nonneg _ (by unfold aQ; norm_num)
  have hEAn : 0 ≤ ((EA : ℚ) : ℝ) := by rw [EA, ← ev_cast]; exact ev_absL_nonneg _ (by unfold aQ; norm_num)
  have hEBn : 0 ≤ ((EB : ℚ) : ℝ) := by rw [EB, ← ev_cast]; exact ev_absL_nonneg _ (by unfold aQ; norm_num)
  have hECn : 0 ≤ ((EC : ℚ) : ℝ) := by rw [EC, ← ev_cast]; exact ev_absL_nonneg _ (by unfold aQ; norm_num)
  have hcE : (0 : ℝ) ≤ (cE : ℝ) := by unfold cE; norm_num
  have hPb : |ev Pl t| ≤ t ^ 2 * (EP : ℝ) := by
    rw [ev_drop_two Pl_head, abs_mul, abs_of_nonneg (sq_nonneg t)]
    exact mul_le_mul_of_nonneg_left (abs_ev_le_evQ _ aQ ht.le hta) (sq_nonneg t)
  have hAb : |ev A1 t| ≤ (EA : ℝ) := abs_ev_le_evQ _ aQ ht.le hta
  have hBb : |ev B1 t| ≤ (EB : ℝ) := abs_ev_le_evQ _ aQ ht.le hta
  have hCb : |ev C1 t| ≤ (EC : ℝ) := abs_ev_le_evQ _ aQ ht.le hta
  have hab : |a| ≤ t ^ 30 * cE := sinh_near ht.le ht1
  have hbb : |b| ≤ t ^ 30 * cE := cosh_near ht.le ht1
  have h30 : 0 ≤ t ^ 30 * (cE : ℝ) := by positivity
  have t1 : |a * ev A1 t| ≤ t ^ 30 * cE * EA := by
    rw [abs_mul]; exact mul_le_mul hab hAb (abs_nonneg _) h30
  have t2 : |b * ev B1 t| ≤ t ^ 30 * cE * EB := by
    rw [abs_mul]; exact mul_le_mul hbb hBb (abs_nonneg _) h30
  have t3 : |-(a * b * ev C1 t)| ≤ t ^ 30 * cE * (t ^ 30 * cE) * EC := by
    rw [abs_neg, abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul hab hbb (abs_nonneg _) h30) hCb (abs_nonneg _) (by positivity)
  have hnum : |ev Pl t + a * ev A1 t + b * ev B1 t + -(a * b * ev C1 t)| ≤
      t ^ 2 * ((EP : ℝ) + t ^ 28 * cE * (EA + EB) + t ^ 58 * cE ^ 2 * EC) := by
    have e1 := abs_add_le (ev Pl t + a * ev A1 t + b * ev B1 t) (-(a * b * ev C1 t))
    have e2 := abs_add_le (ev Pl t + a * ev A1 t) (b * ev B1 t)
    have e3 := abs_add_le (ev Pl t) (a * ev A1 t)
    have : t ^ 2 * ((EP : ℝ) + t ^ 28 * cE * (EA + EB) + t ^ 58 * cE ^ 2 * EC) =
        t ^ 2 * EP + t ^ 30 * cE * EA + t ^ 30 * cE * EB + t ^ 30 * cE * (t ^ 30 * cE) * EC := by ring
    rw [this]; linarith
  have hX : (EP : ℝ) + t ^ 28 * cE * (EA + EB) + t ^ 58 * cE ^ 2 * EC ≤ 2 * (bnd : ℝ) := by
    have p28 : t ^ 28 ≤ ((aQ : ℚ) : ℝ) ^ 28 := pow_le_pow_left₀ ht.le hta' 28
    have p58 : t ^ 58 ≤ ((aQ : ℚ) : ℝ) ^ 58 := pow_le_pow_left₀ ht.le hta' 58
    have q1 : t ^ 28 * cE * (EA + EB) ≤ ((aQ : ℚ) : ℝ) ^ 28 * cE * (EA + EB) := by
      apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right p28 hcE); positivity
    have q2 : t ^ 58 * cE ^ 2 * EC ≤ ((aQ : ℚ) : ℝ) ^ 58 * cE ^ 2 * EC := by
      apply mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right p58 (by positivity)) hECn
    have : 2 * (bnd : ℝ) = (EP : ℝ) + ((aQ : ℚ) : ℝ) ^ 28 * cE * (EA + EB) +
        ((aQ : ℚ) : ℝ) ^ 58 * cE ^ 2 * EC := by
      rw [bnd]; push_cast; ring
    rw [this]; linarith
  have hbndn : 0 ≤ (bnd : ℝ) := by
    have : 0 ≤ (EP : ℝ) + t ^ 28 * cE * (EA + EB) + t ^ 58 * cE ^ 2 * EC := by positivity
    linarith
  have hDl : 2 * t ^ 2 ≤ 2 * t * sh * ch := by
    have : t * 1 ≤ sh * ch := mul_le_mul hsh hch zero_le_one hshp.le
    nlinarith
  rw [hdiff, abs_div, abs_of_pos hD, div_le_iff₀ hD]
  calc _ ≤ t ^ 2 * ((EP : ℝ) + t ^ 28 * cE * (EA + EB) + t ^ 58 * cE ^ 2 * EC) := hnum
    _ ≤ t ^ 2 * (2 * (bnd : ℝ)) := mul_le_mul_of_nonneg_left hX (sq_nonneg t)
    _ = (bnd : ℝ) * (2 * t ^ 2) := by ring
    _ ≤ (bnd : ℝ) * (2 * t * sh * ch) := mul_le_mul_of_nonneg_left hDl hbndn

/-- Main result: `|Rk s − Q(s/2)| ≤ 2·10⁻²⁴` on `(0, log 5]`. -/
theorem Rk_approx {s : ℝ} (hs : 0 < s) (hs5 : s ≤ Real.log 5) :
    |RHColDecomp0499.Rk s - ev ql (s / 2)| ≤ 2 / 10 ^ 24 := by
  have h5 := RHEntry00Bounds0495.b_l5.2
  have hq : (RHEntry00Bounds0495.l5H : ℝ) ≤ 2 * ((aQ : ℚ) : ℝ) := by
    have : RHEntry00Bounds0495.l5H ≤ 2 * aQ := by decide +kernel
    exact_mod_cast this
  have h := Rk_two_mul_approx (t := s / 2) (by positivity) (by linarith)
  rw [show 2 * (s / 2) = s by ring] at h
  have hb := (Rat.cast_le (K := ℝ)).mpr bnd_le
  push_cast at hb
  linarith

end RHRkApprox0500

